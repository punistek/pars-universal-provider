{
  "schemaVersion": 1,
  "id": "sinemakolik",
  "version": 2,
  "enabled": true,
  "name": "Sinemakolik",
  "baseUrl": "https://sinemakolik.com",
  "catalogUrl": "/",
  "topTabs": [
    "Filmler",
    "Diziler",
    "Aksiyon",
    "Dram",
    "Komedi"
  ],
  "categories": [
    {
      "title": "Aile",
      "path": "/aile"
    },
    {
      "title": "Aksiyon",
      "path": "/aksiyon"
    },
    {
      "title": "Animasyon",
      "path": "/animasyon"
    },
    {
      "title": "Bilim Kurgu",
      "path": "/bilim-kurgu"
    },
    {
      "title": "Biyografi",
      "path": "/biyografi"
    },
    {
      "title": "Dram",
      "path": "/dram"
    },
    {
      "title": "Fantastik",
      "path": "/fantastik"
    },
    {
      "title": "Gerilim",
      "path": "/gerilim"
    },
    {
      "title": "Gizem",
      "path": "/gizem"
    },
    {
      "title": "Komedi",
      "path": "/komedi"
    },
    {
      "title": "Korku",
      "path": "/korku"
    },
    {
      "title": "Macera",
      "path": "/macera"
    },
    {
      "title": "Romantik",
      "path": "/romantik"
    },
    {
      "title": "Savaş",
      "path": "/savas"
    },
    {
      "title": "Suç",
      "path": "/suc"
    },
    {
      "title": "Tarih",
      "path": "/tarih"
    }
  ],
  "headers": {
    "User-Agent": "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Mobile Safari/537.36",
    "Accept": "text/html,application/xhtml+xml",
    "Accept-Language": "tr-TR,tr;q=0.9,en-US;q=0.8,en;q=0.7"
  },
  "list": {
    "url": "/arama/?s={query}",
    "item": "main .content .lists .move_k",
    "title": {
      "selector": ".title h2",
      "mode": "text"
    },
    "href": {
      "selector": "a",
      "mode": "attr",
      "attrs": [
        "href"
      ]
    },
    "poster": {
      "selector": "img",
      "mode": "attr",
      "attrs": [
        "data-src",
        "srcset",
        "src"
      ]
    }
  },
  "detail": {
    "title": {
      "selector": ".video_info .b_title h2",
      "mode": "text"
    },
    "poster": {
      "selector": ".video_info .image img",
      "mode": "attr",
      "attrs": [
        "data-src",
        "srcset",
        "src"
      ]
    },
    "overview": {
      "selector": ".video_info .detail .desc",
      "mode": "text"
    },
    "rating": {
      "selector": "#sitepuan",
      "mode": "text"
    },
    "director": {
      "selector": ".video_info .detail [itemprop=\"director\"] p",
      "mode": "text"
    }
  },
  "resolver": {
    "steps": [
      {
        "type": "regex",
        "source": "html",
        "pattern": "pdata\\['prt_0'\\]\\s*=\\s*'([^']+)'",
        "group": 1,
        "saveAs": "playerBase64"
      },
      {
        "type": "base64",
        "mode": "sinemakolik",
        "source": "playerBase64",
        "saveAs": "playerHtml"
      },
      {
        "type": "iframe",
        "source": "playerHtml",
        "saveAs": "embedUrl"
      },
      {
        "type": "get",
        "url": "{embedUrl}",
        "referer": "{detailUrl}",
        "saveAs": "embedHtml"
      },
      {
        "type": "findM3u",
        "source": "embedHtml",
        "name": "Vidmixi HLS"
      }
    ]
  }
}
