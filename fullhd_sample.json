{
  "schemaVersion": 1,
  "id": "fullhdfilmizlesene",
  "version": 2,
  "enabled": true,
  "name": "FullHDFilmizlesene",
  "baseUrl": "https://www.fullhdfilmizlesene.now",
  "catalogUrl": "/",
  "topTabs": [
    "Filmler",
    "Aksiyon",
    "Dram",
    "Komedi",
    "Korku"
  ],
  "categories": [
    {
      "title": "Aile",
      "path": "/filmizle/aile-filmleri"
    },
    {
      "title": "Aksiyon",
      "path": "/filmizle/aksiyon-filmleri"
    },
    {
      "title": "Animasyon",
      "path": "/filmizle/animasyon-filmleri"
    },
    {
      "title": "Belgesel",
      "path": "/filmizle/belgesel-filmleri"
    },
    {
      "title": "Bilim Kurgu",
      "path": "/filmizle/bilim-kurgu-filmleri"
    },
    {
      "title": "Blu Ray",
      "path": "/filmizle/blu-ray-filmler"
    },
    {
      "title": "Çizgi Film",
      "path": "/filmizle/cizgi-filmler"
    },
    {
      "title": "Dram",
      "path": "/filmizle/dram-filmleri"
    },
    {
      "title": "Fantastik",
      "path": "/filmizle/fantastik-filmler"
    },
    {
      "title": "Gerilim",
      "path": "/filmizle/gerilim-filmleri"
    },
    {
      "title": "Gizem",
      "path": "/filmizle/gizem-filmleri"
    },
    {
      "title": "Hint",
      "path": "/filmizle/hint-filmleri"
    },
    {
      "title": "Komedi",
      "path": "/filmizle/komedi-filmleri"
    },
    {
      "title": "Korku",
      "path": "/filmizle/korku-filmleri"
    },
    {
      "title": "Macera",
      "path": "/filmizle/macera-filmleri"
    },
    {
      "title": "Müzikal",
      "path": "/filmizle/muzikal-filmler"
    },
    {
      "title": "Polisiye",
      "path": "/filmizle/polisiye-filmleri"
    },
    {
      "title": "Psikolojik",
      "path": "/filmizle/psikolojik-filmler"
