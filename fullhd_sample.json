  },
  "list": {
    "url": "/?s={query}",
    "item": "a.card-link",
    "title": {
      "selector": ".card-ad",
      "mode": "text"
    },
    "href": {
      "selector": "a.card-link",
      "mode": "attr",
      "attrs": [
        "href"
      ]
    },
    "poster": {
      "selector": ".poster-art img",
      "mode": "attr",
      "attrs": [
        "data-src",
        "data-original",
        "data-srcset",
        "srcset",
        "src"
      ]
    }
  },
  "detail": {
    "title": {
      "selector": ".fbox-title-tx",
      "mode": "text"
    },
    "poster": {
      "selector": ".fbox-cover-img",
      "mode": "attr",
      "attrs": [
        "data-src",
        "src"
      ]
    },
    "overview": {
      "selector": ".fbox-desc p",
      "mode": "text"
    },
    "rating": {
      "selector": ".imdb-score",
      "mode": "text"
    },
    "director": {
      "selector": ".fbox-kadro a[href*=\"/yonetmen/\"] .fk-t b",
      "mode": "text"
    }
  },
  "resolver": {
    "steps": []
  }
